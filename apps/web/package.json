{
  "name": "@datsan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node -e \"require('node:fs').copyFileSync('app-config.json', 'dist/app-config.json')\"",
    "build:admin": "tsc -b && vite build --mode admin",
    "preview": "vite preview --host 0.0.0.0",
    "zmp:login": "npx zmp-cli login",
    "zmp:start": "npx zmp-cli start",
    "zmp:deploy": "npm run build && npx zmp-cli deploy -o dist"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^1.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "zmp-sdk": "^2.27.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.18",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.2.0"
  }
}
